    "signals:analyze": "node src/signals/run-signal-analysis.js",
    "signals:summary": "node src/signals/print-signal-summary.js",
    "signals:strategy": "node src/signals/run-strategy-simulation.js",
    "signals:sweep": "node src/signals/run-strategy-sweep.js",
